  "authors": [
    "JustMili"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/shulkers-in-bundles",
    "sources": "https://github.com/Lumynity-Studios/ShulkersInBundles",
    "issues": "https://github.com/Lumynity-Studios/ShulkersInBundles/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.justmili.shulkersinbundles.fabric.ShulkersInBundlesFabric"
    ]
  },
  "mixins": [
    "shulkersinbundles.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": [
